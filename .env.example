# Admin Agent Docker environment template
# Copy this file to .env before starting Docker Compose.

# Docker host ports
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8030
WEB_PORT=8030
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
PGADMIN_HOST_PORT=5050
VITE_API_PROXY_TARGET=http://localhost:8030

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=admin_agent

# Redis
REDIS_URL=redis://redis:6379/0

# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=admin123

# OpenAI-compatible model service
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7
EMBEDDING_MODEL=text-embedding-3-small

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS for local development. Production nginx uses same-origin requests.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8030"]

# File upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=INFO

# Optional pgAdmin profile
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
